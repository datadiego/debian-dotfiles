general {
    colors = true
    interval = 5

    color_good = "#8EDF5F"
    color_degraded = "#D99145"
    color_bad = "#BF2D2D"
}

order += "cpu_usage"
order += "disk /"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "tztime local"

cpu_usage {
    format = "CPU %usage"
}

disk "/" {
    format = "SSD %avail"
}

ethernet _first_ {
    format_up = "ETH %ip"
    format_down = "ETH down"
}

wireless _first_ {
    format_up = "WLAN %quality %essid"
    format_down = "WLAN down"
}

battery all {
    format = "BAT %percentage"
    format_down = "No battery"
}

tztime local {
    format = "%Y-%m-%d %H:%M"
}

